# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local a GitHub.
# En Vercel, carga las mismas variables en Settings → Environment Variables (Preview y Production).

# --- Firebase Admin SDK (servidor) ---
# Consola de Firebase → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada.
# Del JSON descargado: project_id, client_email y private_key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Entre comillas y en una sola línea, con los saltos de línea escritos como \n (tal como vienen en el JSON).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Firebase Auth REST (inicio de sesión) ---
# Consola de Firebase → Configuración del proyecto → General → Clave de API web.
# Solo se usa en el servidor: no lleva el prefijo NEXT_PUBLIC_.
FIREBASE_API_KEY=

# --- Reglas de la aplicación ---
# Dominios de correo permitidos para crear cuenta, separados por comas (el PO confirma el dominio final).
ALLOWED_EMAIL_DOMAINS=mail.isil.pe

# --- Emuladores (solo desarrollo local con `npm run emulators`) ---
# Descomenta estas dos líneas para usar los emuladores en lugar del proyecto real.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
