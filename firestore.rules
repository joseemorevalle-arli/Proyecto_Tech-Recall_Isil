rules_version = '2';

// Cada estudiante solo lee y escribe dentro de users/{uid} (su documento y sus subcolecciones).
// Todo lo demás queda denegado. El servidor usa el Admin SDK, que no pasa por estas reglas:
// son una segunda barrera por si alguien intenta acceder a Firestore directamente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
